# Primary LLM Provider: Groq API (OpenAI-compatible)
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=openai/gpt-oss-20b

# (Optional fallback key name for generic OpenAI-compatible providers)
# LLM_API_KEY=your-api-key-here

# Backend API Configuration
API_BASE_URL=http://localhost:8000
API_HOST=127.0.0.1
API_PORT=8000

# Streamlit Frontend Configuration
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501

# RAG & Chroma Vector Database Configuration (Local sentence-transformers embeddings; NOT sent to Groq)
VECTOR_DB_PATH=.data/vector_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_COLLECTION=customer-support
RAG_TOP_K=3
